# ============================================================================
# TEMPLATE VARIABEL LINGKUNGAN FIREBASE (LOGBOOKRISET.ID)
# Salin berkas ini menjadi .env lalu isi nilainya dari Firebase Console
# ============================================================================

FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# ============================================================================
# TEMPLATE PAYMENT GATEWAY PAKASIR (LOGBOOKRISET.ID)
# ============================================================================
PAKASIR_SLUG=your_pakasir_slug_here
PAKASIR_API_KEY=your_pakasir_api_key_here
PAKASIR_WEBHOOK_SECRET=your_pakasir_webhook_secret_here
PAKASIR_AMOUNT=55500
PAKASIR_SUBSCRIPTION_DAYS=90

# ============================================================================
# TEMPLATE GOOGLE DRIVE OBJECT STORAGE (REKAMAN WAWANCARA GOOGLE ONE 5 TB)
# ============================================================================
# OPSI A: Google One Pribadi 5 TB (Paket Google AI Pro) via OAuth 2.0
GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id_here
GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8085/oauth2callback

# OPSI B: Folder Induk Drive (Opsional, jika ingin mengunci ke folder tertentu)
GOOGLE_DRIVE_PARENT_FOLDER_ID=your_parent_folder_id_here

